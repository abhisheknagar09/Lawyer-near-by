---
import '../styles/global.css';
import SmoothScroll from '../components/SmoothScroll.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lawyer Near By — Legal Help That Starts With a Real Conversation',
  description =
    'Talk to a practising advocate about your matter — in your language, by audio or video. Corporate, civil, criminal, family and property law.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e3b2e" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
    <SmoothScroll />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -120%);
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--c-fir);
    color: var(--c-on-fir);
    border-radius: 0 0 12px 12px;
    font-size: var(--fs-small);
    font-weight: 600;
    transition: transform 0.2s var(--ease);
  }

  .skip:focus-visible {
    transform: translate(-50%, 0);
  }
</style>
