---
import VariationLayout from '../../layouts/VariationLayout.astro';
import Icon from '../../components/Icon.astro';
import { services, site, testimonials } from '../../data/site';

const features = [
  { icon: 'clock', label: 'Up to 30 minutes of consultation' },
  { icon: 'audio', label: 'Audio consultation' },
  { icon: 'video', label: 'Video consultation' },
  { icon: 'globe', label: 'Multiple language support' },
] as const;

const quote = testimonials[0];
const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
---

<VariationLayout
  title="Spotlight — Lawyer Near By"
  description="Dark motion study: a cursor-lit hero, counters and cards that tilt to the pointer."
  current="spotlight"
  ground="#071812"
>
  <div class="dark">
    <!-- ══ hero ════════════════════════════════════════════ -->
    <section class="hero" data-spot>
      <span class="hero__light" aria-hidden="true"></span>

      <div class="shell hero__grid">
        <div>
          <span class="tag" data-reveal="up">
            <Icon name="shield" size={13} />
            {site.regulator}
          </span>

          <h1 class="hero__title" data-reveal="up" style="--d:90ms">
            Know where you stand.<br />
            <em>Before you spend a rupee.</em>
          </h1>

          <p class="hero__lede" data-reveal="up" style="--d:190ms">
            Corporate, civil, criminal, family and property matters — handled by advocates who give
            you the straight answer first.
          </p>

          <div class="hero__actions" data-reveal="up" style="--d:290ms">
            <a class="btn btn--lime" href="#offer" data-magnet>
              Explore consultation
              <span class="btn__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={13} />
              </span>
            </a>
            <a class="btn ghost" href="#practice">
              Practice areas
              <span class="btn__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={13} />
              </span>
            </a>
          </div>
        </div>

        <figure class="figure" data-reveal="scale" style="--d:240ms">
          <span class="figure__glow" aria-hidden="true"></span>
          <img
            class="figure__img floats"
            src="/images/justice-steel.png"
            alt="Figure of Justice holding balanced scales"
            width="446"
            height="551"
            fetchpriority="high"
          />
        </figure>
      </div>

      <ul class="shell stats">
        {
          [
            { to: 12, suffix: '+', label: 'Years in practice' },
            { to: 2400, suffix: '+', label: 'Matters handled' },
            { to: 95, suffix: '%', label: 'Favourable outcomes' },
            { to: 6, suffix: '', label: 'Languages spoken' },
          ].map((s, i) => (
            <li data-reveal="up" style={`--d:${i * 80}ms`}>
              <strong class="stats__v tally" data-tally={s.to} data-suffix={s.suffix}>
                0{s.suffix}
              </strong>
              <span class="stats__l">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ══ practice ════════════════════════════════════════ -->
    <section class="sec shell" id="practice">
      <span class="kick" data-reveal="up">Practice areas</span>
      <h2 class="h2" data-reveal="up" style="--d:80ms">
        Five kinds of trouble, <em>handled properly.</em>
      </h2>

      <ul class="grid">
        {
          services.map((s, i) => (
            <li class="card" data-tilt data-reveal="up" style={`--d:${i * 70}ms`}>
              <span class="card__icon" aria-hidden="true">
                <Icon name={s.icon as any} size={19} />
              </span>
              <h3 class="card__title">{s.title}</h3>
              <p class="card__body">{s.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ══ offer ═══════════════════════════════════════════ -->
    <section class="sec shell" id="offer">
      <div class="offer" data-reveal="up">
        <div>
          <span class="kick">Affordable consultation</span>
          <h2 class="h2 offer__h">
            Expert legal guidance, <em>without the heavy price tag.</em>
          </h2>
          <p class="offer__lede">
            Get professional legal guidance for your personal or business legal concerns through an
            affordable consultation.
          </p>

          <div class="price">
            <p class="price__amt" aria-hidden="true">
              <span class="price__cur">₹</span><span class="price__fig">50</span>
            </p>
            <span class="price__rule" aria-hidden="true"></span>
            <p class="price__dur" aria-hidden="true">
              <span class="price__n">30</span>
              <span class="price__u">Minutes</span>
            </p>
            <p class="sr-only">50 rupees for a consultation of up to 30 minutes.</p>
          </div>
        </div>

        <div class="incl">
          <p class="incl__label">What is included</p>
          <ul class="incl__list">
            {
              features.map((f) => (
                <li>
                  <span aria-hidden="true">
                    <Icon name={f.icon} size={15} />
                  </span>
                  {f.label}
                </li>
              ))
            }
          </ul>
          <a class="btn btn--lime incl__cta" href="#close" data-magnet>
            Explore Consultation
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
          <p class="incl__fine">No obligation to continue afterwards.</p>
        </div>
      </div>
    </section>

    <!-- ══ proof ═══════════════════════════════════════════ -->
    <section class="sec shell proof">
      <div class="proof__shot" data-reveal="left">
        <img
          src="/images/advocate.jpg"
          alt="An advocate from the Lawyer Near By team in the firm's law library"
          width="1000"
          height="1000"
          loading="lazy"
        />
      </div>
      <div data-reveal="right">
        <span class="kick">Client</span>
        <blockquote class="proof__q">&ldquo;{quote.quote}&rdquo;</blockquote>
        <p class="proof__by"><strong>{quote.name}</strong> {quote.role}</p>
      </div>
    </section>

    <!-- ══ close ═══════════════════════════════════════════ -->
    <section class="sec shell" id="close">
      <div class="close" data-reveal="up">
        <h2 class="h2 close__h">Tell us what happened, in your own words.</h2>
        <p class="close__p">
          No jargon needed. We work out what matters, and tell you what your options actually cost.
        </p>
        <div class="close__acts">
          <a class="btn btn--lime" href={telHref} data-magnet>
            Call {site.phone}
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
          <a class="btn ghost" href={`mailto:${site.email}`}>
            Email us
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="shell foot__in">
        <p>&copy; {new Date().getFullYear()} {site.name} · {site.address}</p>
        <p>General information only, not advice on your specific matter.</p>
      </div>
    </footer>
  </div>
</VariationLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (!reduced && fine) {
    // --- hero spotlight follows the pointer -----------------------------
    const spot = document.querySelector<HTMLElement>('[data-spot]');
    if (spot) {
      spot.addEventListener('pointermove', (e) => {
        const r = spot.getBoundingClientRect();
        spot.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        spot.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
    }

    // --- cards tilt toward the pointer ----------------------------------
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty('--rx', `${(-py * 6).toFixed(2)}deg`);
        card.style.setProperty('--ry', `${(px * 6).toFixed(2)}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });

    // --- buttons lean toward the pointer --------------------------------
    document.querySelectorAll<HTMLElement>('[data-magnet]').forEach((btn) => {
      btn.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        btn.style.setProperty('--tx', `${((e.clientX - r.left) / r.width - 0.5) * 9}px`);
        btn.style.setProperty('--ty', `${((e.clientY - r.top) / r.height - 0.5) * 6}px`);
      });
      btn.addEventListener('pointerleave', () => {
        btn.style.setProperty('--tx', '0px');
        btn.style.setProperty('--ty', '0px');
      });
    });
  }
</script>

<style>
  /* palette override for this page only */
  .dark {
    --ground: #071812;
    --raise: rgba(255, 255, 255, 0.045);
    --edge: rgba(236, 229, 215, 0.14);
    --white: #ffffff;
    --soft: rgba(236, 229, 215, 0.74);
    --faint: rgba(236, 229, 215, 0.5);

    background: var(--ground);
    color: var(--white);
  }

  .sec {
    padding-block: clamp(2.75rem, 1.8rem + 3.4vw, 5rem);
  }

  .kick {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-lime);
  }

  .h2 {
    margin-top: 0.85rem;
    font-size: var(--fs-h2);
    color: var(--white);
  }

  .h2 em {
    font-style: normal;
    color: var(--c-lime);
  }

  .ghost {
    background: transparent;
    color: var(--white);
    border: 1px solid var(--edge);
  }

  .ghost .btn__arrow {
    background: rgba(255, 255, 255, 0.1);
  }

  .ghost:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  /* --- hero --- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.25rem, 1.4rem + 3.2vw, 4.5rem);
  }

  .hero__light {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      420px circle at var(--mx, 70%) var(--my, 28%),
      rgba(199, 240, 95, 0.16),
      transparent 70%
    );
    transition: background-position 0.2s linear;
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    align-items: center;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-chip);
    border: 1px solid var(--edge);
    background: rgba(255, 255, 255, 0.05);
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--soft);
  }

  .tag :global(svg) {
    color: var(--c-lime);
  }

  .hero__title {
    margin-top: 1.2rem;
    font-size: var(--fs-display);
    letter-spacing: -0.045em;
    color: var(--white);
  }

  .hero__title em {
    font-style: normal;
    color: var(--c-lime);
  }

  .hero__lede {
    margin-top: 1.15rem;
    max-width: 38ch;
    font-size: var(--fs-lead);
    line-height: 1.7;
    color: var(--soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.9rem;
  }

  :global([data-magnet]) {
    translate: var(--tx, 0) var(--ty, 0);
  }

  .figure {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
  }

  .figure__glow {
    position: absolute;
    width: min(86%, 330px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199, 240, 95, 0.22), transparent 68%);
    filter: blur(26px);
  }

  /* the source photograph is cropped mid-figure, so it dissolves into the
     ground instead of ending on a hard horizontal cut */
  .figure__img {
    position: relative;
    width: auto;
    max-width: 100%;
    height: clamp(260px, 36vw, 420px);
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
    mask-image: linear-gradient(180deg, #000 72%, transparent 97%);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 97%);
  }

  /* --- stats --- */
  .stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    margin-top: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    padding-top: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    border-top: 1px solid var(--edge);
  }

  .stats__v {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.1;
    color: var(--c-lime);
  }

  .stats__l {
    font-size: var(--fs-small);
    color: var(--faint);
  }

  /* --- practice grid --- */
  .grid {
    display: grid;
    gap: 1rem;
    margin: clamp(2rem, 1.4rem + 2.4vw, 2.75rem) 0 0;
  }

  .card {
    padding: 1.5rem;
    border-radius: var(--r-card);
    background: var(--raise);
    border: 1px solid var(--edge);
    transform: perspective(700px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(199, 240, 95, 0.4);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 14px;
    background: rgba(199, 240, 95, 0.12);
    border: 1px solid rgba(199, 240, 95, 0.28);
    color: var(--c-lime);
  }

  .card__title {
    margin-top: 1.1rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--white);
  }

  .card__body {
    margin-top: 0.45rem;
    font-size: var(--fs-small);
    color: var(--soft);
  }

  /* --- offer --- */
  .offer {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    border-radius: var(--r-panel);
    background:
      radial-gradient(70% 90% at 12% 0%, rgba(199, 240, 95, 0.14), transparent 62%),
      rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(199, 240, 95, 0.26);
  }

  .offer__h {
    margin-top: 0.85rem;
  }

  .offer__lede {
    margin-top: 0.9rem;
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.7;
    color: var(--soft);
  }

  .price {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.5rem + 1.6vw, 1.5rem);
    margin-top: 1.5rem;
  }

  .price__amt {
    display: flex;
    align-items: flex-start;
    gap: 0.02em;
    line-height: 0.88;
    font-family: var(--font-display);
    color: var(--c-lime);
  }

  .price__cur {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .price__fig {
    font-size: clamp(3.75rem, 2.2rem + 7vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .price__rule {
    width: 1px;
    align-self: stretch;
    margin-block: 0.5rem;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(199, 240, 95, 0.5) 25%,
      rgba(199, 240, 95, 0.5) 75%,
      transparent
    );
  }

  .price__dur {
    display: grid;
    line-height: 1;
    font-family: var(--font-display);
  }

  .price__n {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--white);
  }

  .price__u {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .incl {
    padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    border-radius: var(--r-card);
    background: rgba(7, 24, 18, 0.6);
    border: 1px solid var(--edge);
  }

  .incl__label {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .incl__list {
    display: grid;
    gap: 0.8rem;
    margin: 1rem 0 0;
  }

  .incl__list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .incl__list span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 11px;
    background: rgba(199, 240, 95, 0.12);
    border: 1px solid rgba(199, 240, 95, 0.3);
    color: var(--c-lime);
  }

  .incl__cta {
    width: 100%;
    justify-content: space-between;
    margin-top: 1.4rem;
  }

  .incl__fine {
    margin-top: 1rem;
    font-size: var(--fs-micro);
    color: var(--faint);
  }

  /* --- proof --- */
  .proof {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    align-items: center;
  }

  .proof__shot {
    border-radius: var(--r-panel);
    overflow: hidden;
    border: 1px solid var(--edge);
    max-height: 420px;
  }

  .proof__shot img {
    width: 100%;
    height: auto;
  }

  .proof__q {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.9vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.45;
    color: var(--white);
  }

  .proof__by {
    margin-top: 1.25rem;
    font-size: var(--fs-small);
    color: var(--faint);
  }

  .proof__by strong {
    display: block;
    color: var(--white);
  }

  /* --- close --- */
  .close {
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    border-radius: var(--r-panel);
    background: linear-gradient(140deg, rgba(20, 80, 62, 0.75), rgba(7, 24, 18, 0.9));
    border: 1px solid var(--edge);
    text-align: center;
  }

  .close__h {
    margin-inline: auto;
    max-width: 20ch;
  }

  .close__p {
    margin: 0.9rem auto 0;
    max-width: 44ch;
    color: var(--soft);
  }

  .close__acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  /* --- footer --- */
  .foot {
    border-top: 1px solid var(--edge);
  }

  .foot__in {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.75rem;
    font-size: var(--fs-micro);
    color: var(--faint);
  }

  @media (max-width: 559px) {
    .hero__actions :global(.btn),
    .close__acts :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (min-width: 620px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .foot__in {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 2rem;
    }
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .offer,
    .proof {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
