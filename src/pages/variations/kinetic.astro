---
import VariationLayout from '../../layouts/VariationLayout.astro';
import Icon from '../../components/Icon.astro';
import Consultation from '../../components/Consultation.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { process, services, site } from '../../data/site';
import { url } from '../../lib/url';

/** the word that cycles in the headline */
const matters = ['property', 'business', 'family', 'criminal', 'tenancy'];
---

<VariationLayout
  title="Kinetic — Lawyer Near By"
  description="Kinetic type study: a cycling headline, a sticky process rail and a dragged practice strip."
  current="kinetic"
>
  <!-- ══ hero ══════════════════════════════════════════════ -->
  <section class="hero">
    <div class="shell">
      <span class="eyebrow hero__eye" data-reveal="up">
        <Icon name="sparkle" size={13} />
        Consultations from ₹50
      </span>

      <h1 class="hero__title lines">
        <span class="line" style="--d:120ms"><span>Straight answers</span></span>
        <span class="line" style="--d:230ms"><span>for your</span></span>
        <span class="line" style="--d:340ms">
          <span>
            <span class="swap" data-swap>
              {
                matters.map((word, i) => (
                  <span class:list={['swap__w', { 'is-on': i === 0 }]} aria-hidden={i !== 0}>
                    {word}
                  </span>
                ))
              }
              <span class="sr-only">property, business, family, criminal and tenancy</span>
            </span>
            <em class="hero__tail">matter.</em>
          </span>
        </span>
      </h1>

      <div class="hero__base">
        <p class="lede hero__lede" data-reveal="up" style="--d:480ms">
          Talk to a practising advocate before you commit to anything — by audio or video, in the
          language you think in.
        </p>

        <div class="hero__actions" data-reveal="up" style="--d:560ms">
          <a class="btn btn--lime" href="#consultation">
            Explore consultation
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
          <a class="btn btn--fir" href="#route">
            See how it works
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
        </div>
      </div>

      <figure class="band" data-reveal="scale" style="--d:400ms">
        <img
          class="band__fig floats"
          src={url("/images/justice-stone.png")}
          alt="Carved figure of Justice holding scales and a sword"
          width="597"
          height="1002"
          fetchpriority="high"
        />
        <figcaption class="band__note">
          <Icon name="shield" size={15} />
          {site.regulator}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ══ practice strip ════════════════════════════════════ -->
  <section class="strip" id="practice">
    <div class="shell strip__head">
      <h2 class="h2" data-reveal="up">Practice areas</h2>
      <p class="strip__hint" aria-hidden="true">Scroll sideways &rarr;</p>
    </div>

    <ul class="rail" tabindex="0" aria-label="Practice areas, scrollable" data-reveal="up">
      {
        services.map((s, i) => (
          <li class="rail__card">
            <span class="rail__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="rail__icon" aria-hidden="true">
              <Icon name={s.icon as any} size={19} />
            </span>
            <h3 class="rail__title">{s.title}</h3>
            <p class="rail__body">{s.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ══ sticky route ══════════════════════════════════════ -->
  <section class="route section" id="route">
    <div class="shell route__grid">
      <div class="route__head">
        <span class="eyebrow">How it works</span>
        <h2 class="h2 route__title">The whole route, <span class="accent">start to finish.</span></h2>
        <p class="lede route__lede">
          Four steps from the first message to advice you can act on. Nothing hidden in between.
        </p>
      </div>

      <ol class="route__steps">
        {
          process.map((item) => (
            <li class="rstep" data-step>
              <span class="rstep__n">{item.step}</span>
              <div>
                <h3 class="rstep__title">{item.title}</h3>
                <p class="rstep__body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div data-reveal="up"><Consultation /></div>
  <div data-reveal="up"><Contact /></div>
  <Footer />
</VariationLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- cycling headline word ---------------------------------------------
  // The slot is sized to the word on show, so the tail of the line slides
  // rather than sitting after a gap left by the longest word.
  const swap = document.querySelector<HTMLElement>('[data-swap]');
  if (swap) {
    const words = Array.from(swap.querySelectorAll<HTMLElement>('.swap__w'));
    let i = 0;
    let widths: number[] = [];

    const measure = () => {
      swap.style.width = 'auto';
      widths = words.map((w) => w.getBoundingClientRect().width);
      swap.style.width = `${widths[i]}px`;
    };

    measure();
    window.addEventListener('resize', measure);
    if (document.fonts) document.fonts.ready.then(measure);

    if (!reduced) {
      setInterval(() => {
        words[i].classList.remove('is-on');
        words[i].classList.add('is-out');
        i = (i + 1) % words.length;
        words[i].classList.remove('is-out');
        words[i].classList.add('is-on');
        swap.style.width = `${widths[i]}px`;
        window.setTimeout(() => {
          words.forEach((w, n) => {
            if (n !== i) w.classList.remove('is-out');
          });
        }, 600);
      }, 2300);
    }
  }

  // --- route steps light up as they pass ---------------------------------
  const steps = document.querySelectorAll<HTMLElement>('[data-step]');
  if (steps.length && !reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-active', entry.isIntersecting);
        });
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  } else {
    steps.forEach((s) => s.classList.add('is-active'));
  }
</script>

<style>
  /* --- hero --- */
  .hero {
    padding-block: clamp(2rem, 1.2rem + 3vw, 3.5rem) clamp(2rem, 1.4rem + 2.4vw, 3rem);
  }

  .hero__eye {
    margin-bottom: 1.1rem;
  }

  .hero__title {
    font-size: clamp(2.6rem, 1.3rem + 6.4vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .hero__tail {
    font-style: normal;
    color: var(--c-ink-faint);
  }

  /* the cycling word sits in a fixed slot so the line never jumps */
  .swap {
    position: relative;
    display: inline-grid;
    vertical-align: top;
    overflow: hidden;
    color: var(--c-fir);
    transition: width 0.45s var(--ease);
  }

  .swap__w {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.5em);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }

  .swap__w.is-on {
    opacity: 1;
    transform: none;
  }

  .swap__w.is-out {
    opacity: 0;
    transform: translateY(-0.5em);
  }

  .hero__base {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
  }

  .hero__lede {
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* --- figure band --- */
  .band {
    position: relative;
    display: grid;
    place-items: center;
    margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 0;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-panel);
    background:
      radial-gradient(60% 80% at 50% 110%, rgba(199, 240, 95, 0.28), transparent 62%),
      var(--c-sand);
    overflow: hidden;
  }

  .band__fig {
    width: auto;
    max-width: 100%;
    height: clamp(230px, 32vw, 380px);
    object-fit: contain;
    filter: drop-shadow(0 24px 30px rgba(14, 59, 46, 0.28));
  }

  .band__note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--c-ink-soft);
  }

  .band__note :global(svg) {
    color: var(--c-fir);
  }

  /* --- shared heading --- */
  .h2 {
    font-size: var(--fs-h2);
  }

  /* --- practice strip --- */
  .strip {
    padding-block: clamp(2.5rem, 1.7rem + 3.2vw, 4.5rem);
  }

  .strip__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .strip__hint {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }

  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(255px, 300px);
    gap: 1rem;
    margin: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem) 0 0;
    padding: 0 var(--gutter) 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .rail__card {
    position: relative;
    padding: 1.5rem;
    border-radius: var(--r-card);
    background: var(--c-card);
    border: 1px solid var(--c-hairline);
    scroll-snap-align: center;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .rail__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .rail__n {
    position: absolute;
    top: 1.1rem;
    right: 1.3rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: rgba(14, 59, 46, 0.1);
  }

  .rail__icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 14px;
    background: var(--c-sand);
    color: var(--c-fir);
  }

  .rail__title {
    margin-top: 1.1rem;
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .rail__body {
    margin-top: 0.45rem;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  /* --- sticky route --- */
  .route__grid {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    align-items: start;
  }

  .route__title {
    margin-top: 0.85rem;
  }

  .route__lede {
    margin-top: 0.9rem;
    max-width: 34ch;
  }

  .route__steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .rstep {
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem;
    border-radius: var(--r-card);
    border: 1px solid var(--c-hairline);
    background: var(--c-card);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .rstep__n {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    flex: none;
    border-radius: 50%;
    background: var(--c-sand);
    color: var(--c-fir);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  .rstep__title {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .rstep__body {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .rstep.is-active {
    background: var(--c-fir);
    border-color: transparent;
  }

  .rstep.is-active .rstep__n {
    background: var(--c-lime);
    color: var(--c-fir-deep);
  }

  .rstep.is-active .rstep__title {
    color: #ffffff;
  }

  .rstep.is-active .rstep__body {
    color: var(--c-on-fir-soft);
  }

  @media (max-width: 559px) {
    .hero__actions :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (min-width: 900px) {
    .hero__base {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 2.5rem;
    }

    .route__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .route__head {
      position: sticky;
      top: 5.5rem;
    }
  }
</style>
