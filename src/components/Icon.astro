  check: '<path d="m5 12.6 4.6 4.6L19 7.8"/>',
  plus: '<path d="M12 5.5v13M5.5 12h13"/>',
  minus: '<path d="M5.5 12h13"/>',
  'chevron-left': '<path d="M14.5 6 8.5 12l6 6"/>',
