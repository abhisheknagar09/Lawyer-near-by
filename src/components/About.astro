---
import Icon from './Icon.astro';

const pillars = [
  {
    icon: 'scale',
    title: 'Plain-language advice',
    body: 'No jargon and no hedging. You get told what is likely to happen.',
  },
  {
    icon: 'shield',
    title: 'Confidential by default',
    body: 'Every conversation is privileged and stays between us.',
  },
  {
    icon: 'users',
    title: 'One advocate throughout',
    body: 'The person you speak to is the person who handles your matter.',
  },
] as const;
---

<section class="about section" id="about">
  <div class="shell">
    <div class="about__grid">
      <div class="about__shot">
        <img
          src="/images/consultation.jpg"
          alt="Two advocates in conversation in a courthouse corridor"
          width="1200"
          height="672"
          loading="lazy"
        />
      </div>

      <div class="about__copy">
        <span class="eyebrow">About us</span>
        <h2 class="about__title">Built on integrity, <span class="accent">driven by justice.</span></h2>
        <p class="lede about__lede">
          Lawyer Near By is a client-focused practice dedicated to protecting your rights and
          delivering clear, results-driven solutions.
        </p>
        <p class="about__body">
          We combine strategic thinking with precise execution to guide clients through complex
          situations with confidence — because your case deserves more than advice, it deserves
          advocacy.
        </p>

        <a class="btn btn--fir about__cta" href="#consultation">
          Talk to an advocate
          <span class="btn__arrow" aria-hidden="true">
            <Icon name="arrow-up-right" size={13} />
          </span>
        </a>
      </div>
    </div>

    <ul class="pillars">
      {
        pillars.map((pillar) => (
          <li class="pillar">
            <span class="pillar__icon" aria-hidden="true">
              <Icon name={pillar.icon} size={19} />
            </span>
            <h3 class="pillar__title">{pillar.title}</h3>
            <p class="pillar__body">{pillar.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3rem);
    align-items: center;
  }

  .about__shot {
    border-radius: var(--r-panel);
    overflow: hidden;
    background: var(--c-sand);
  }

  .about__shot img {
    width: 100%;
    height: auto;
  }

  .about__title {
    margin-top: 0.85rem;
    font-size: var(--fs-h2);
  }

  .about__lede {
    margin-top: 1rem;
    color: var(--c-ink);
    font-weight: 500;
  }

  .about__body {
    margin-top: 0.9rem;
    color: var(--c-ink-soft);
    line-height: 1.75;
  }

  .about__cta {
    margin-top: 1.75rem;
  }

  .pillars {
    display: grid;
    gap: 1rem;
    margin: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem) 0 0;
  }

  .pillar {
    padding: 1.5rem;
    border-radius: var(--r-card);
    background: var(--c-card);
    border: 1px solid var(--c-hairline);
  }

  .pillar__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 14px;
    background: var(--c-sand);
    color: var(--c-fir);
  }

  .pillar__title {
    margin-top: 1rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .pillar__body {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  /* three wide, short cards stacked on a tablet looked sparse */
  @media (min-width: 620px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }
</style>
