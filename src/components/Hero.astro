---
import Icon from './Icon.astro';
import { heroStats } from '../data/site';
---

<section class="hero" id="top">
  <div class="shell">
    <div class="hero__grid">
      <div class="hero__copy">
        <span class="pill">
          Consultations from <b>₹50</b>
        </span>

        <h1 class="hero__title">
          Legal help that starts with a <span class="mark accent">real conversation.</span>
        </h1>

        <p class="lede hero__lede">
          Talk to a practising advocate about your matter — in your language, by audio or video,
          before you commit to anything.
        </p>

        <div class="hero__actions">
          <a class="btn btn--lime" href="#consultation">
            Explore consultation
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
          <a class="btn btn--fir" href="#services">
            Browse practice areas
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
        </div>
      </div>

      <div class="shot">
        <img
          src="/images/advocate.jpg"
          alt="An advocate from the Lawyer Near By team in the firm's law library"
          width="1000"
          height="1000"
          fetchpriority="high"
        />
        <p class="shot__chip">
          <span class="shot__icon" aria-hidden="true"><Icon name="globe" size={16} /></span>
          English, Hindi, Marathi, Gujarati, Tamil &amp; Bengali
        </p>
      </div>
    </div>

    <ul class="panel stats">
      {
        heroStats.map((stat) => (
          <li class="stat">
            <strong class="stat__value">{stat.value}</strong>
            <span class="stat__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.5rem 0.45rem 0.95rem;
    border-radius: var(--r-chip);
    background: var(--c-card);
    border: 1px solid var(--c-hairline);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-ink-soft);
  }

  .pill b {
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-chip);
    background: var(--c-lime);
    color: var(--c-fir-deep);
    font-size: var(--fs-micro);
    font-weight: 700;
  }

  .hero__title {
    margin-top: 1.2rem;
    font-size: var(--fs-display);
    letter-spacing: -0.04em;
  }

  .hero__lede {
    margin-top: 1.15rem;
    max-width: 40ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.9rem;
  }

  /* --- photo card --- */
  .shot {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: var(--c-sand);
    /* the source is square: uncapped it becomes a 700px slab on a tablet */
    max-height: 440px;
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  .shot__chip {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.95rem;
    border-radius: 18px;
    background: rgba(247, 244, 238, 0.92);
    backdrop-filter: blur(10px);
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-ink);
  }

  .shot__icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: 11px;
    background: var(--c-fir);
    color: var(--c-lime);
  }

  /* --- stats band --- */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding: 1.4rem clamp(1.1rem, 0.6rem + 2vw, 2rem);
    font-variant-numeric: tabular-nums;
  }

  .stat__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: #ffffff;
  }

  .stat__label {
    font-size: var(--fs-small);
    color: var(--c-on-fir-soft);
  }

  /* stacked buttons read as a deliberate pair at full width */
  @media (max-width: 559px) {
    .hero__actions :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (min-width: 620px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .shot {
      max-height: none;
    }
  }
</style>
