---
import Icon from './Icon.astro';
import { site } from '../data/site';

const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
---

<section class="cta section" id="contact">
  <div class="shell">
    <div class="panel cta__panel">
      <div class="cta__copy">
        <span class="eyebrow eyebrow--on-fir">Get started</span>
        <h2 class="cta__title">Tell us what happened, in your own words.</h2>
        <p class="lede lede--on-fir cta__lede">
          No jargon needed. We work out what matters, and tell you what your options actually cost.
        </p>

        <div class="cta__actions">
          <a class="btn btn--lime" href={telHref}>
            Call {site.phone}
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
          <a class="btn btn--ghost" href={`mailto:${site.email}`}>
            Email us
            <span class="btn__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
        </div>
      </div>

      <aside class="recap" aria-label="Consultation summary">
        <p class="recap__label">Consultation</p>
        <p class="recap__price">
          <span class="recap__fee" aria-hidden="true">
            <span class="recap__currency">₹</span>50
          </span>
          <span class="recap__mins" aria-hidden="true">30 min</span>
          <span class="sr-only">50 rupees for 30 minutes.</span>
        </p>
        <ul class="recap__list">
          <li><Icon name="audio" size={14} /> Audio or video</li>
          <li><Icon name="globe" size={14} /> Your language</li>
          <li><Icon name="shield" size={14} /> Fully confidential</li>
        </ul>
        <a class="recap__link" href="#consultation">
          Back to consultation details
          <Icon name="arrow-up-right" size={13} />
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    align-items: center;
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
  }

  .cta__title {
    margin-top: 0.85rem;
    font-size: var(--fs-h2);
    max-width: 18ch;
    color: #ffffff;
  }

  .cta__lede {
    margin-top: 0.9rem;
    max-width: 40ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  .recap {
    padding: 1.5rem;
    border-radius: var(--r-card);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--c-hairline-dark);
  }

  .recap__label {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-on-fir-faint);
  }

  .recap__price {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--c-lime);
  }

  .recap__fee {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.02em;
    line-height: 1;
  }

  .recap__currency {
    font-size: 0.58em;
    font-weight: 700;
    line-height: 1.25;
  }

  /* a rule keeps the duration from reading as part of the figure */
  .recap__mins {
    padding-left: 0.75rem;
    border-left: 1px solid var(--c-hairline-dark);
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    color: #ffffff;
  }

  .recap__list {
    display: grid;
    gap: 0.55rem;
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-hairline-dark);
    font-size: var(--fs-small);
    color: var(--c-on-fir-soft);
  }

  .recap__list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .recap__list :global(svg) {
    flex: none;
    color: var(--c-lime);
  }

  .recap__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-lime);
  }

  .recap__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 559px) {
    .cta__actions :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (min-width: 900px) {
    .cta__panel {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .recap {
      max-width: 22rem;
      margin-inline-start: auto;
    }
  }
</style>
